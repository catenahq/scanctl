{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>catenahq/scanctl:secure-base"],
  "packageRules": [
    {
      "description": "Go module minor/patch: group + automerge after the shared cooldown.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules (minor+patch)",
      "automerge": true
    },
    {
      "description": "Pinned scanners in tools.lock: group, automerge after cooldown + a green self-scan. The branch runs scanctl refresh-digests, so the sha256 of each release file of the new versions lands in the bump's commit.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tools.lock"],
      "groupName": "pinned scanners",
      "automerge": true,
      "postUpgradeTasks": {
        "commands": ["go run ./cmd/scanctl refresh-digests"],
        "fileFilters": ["tools.lock"],
        "executionMode": "branch",
        "installTools": { "golang": {} }
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump pinned scanner versions in tools.lock",
      "managerFilePatterns": ["/^tools\\.lock$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
